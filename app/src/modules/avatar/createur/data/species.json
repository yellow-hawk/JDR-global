{
  "_doc": {
    "title": "species.json — LE cerveau de l'extensibilite (data-driven)",
    "regle": "Le code ne connait AUCUNE espece en dur. Tout vit ici. Ajouter une espece = deposer des assets + ajouter une entree dans 'species'. Aucune ligne de logique metier modifiee.",
    "conventionCommentaires": "JSON n'autorise pas les // . Toute cle prefixee par '_' (ex: _doc, _comment, _example) est de la DOCUMENTATION et doit etre ignoree par le moteur. Les vraies donnees n'ont jamais de prefixe '_'.",
    "commentAjouterUneEspece": [
      "1. Creer le dossier public/assets/species/<id>/ (+ sous-dossiers hair/, eyebrows/, beard/, textures/).",
      "2. Y deposer le(s) GLB de base (exporte(s) depuis MakeHuman/Blender) et les GLB d'assets.",
      "3. Copier le bloc 'human' ci-dessous, le renommer (id, label), ajuster les chemins 'model' et les sections morphTargets/materials/assetSlots.",
      "4. C'est tout : l'UI et le comportement se generent automatiquement depuis cette config."
    ],
    "referenceDesChamps": {
      "id": "Identifiant stable et unique de l'espece (kebab/lowercase). Sert de cle dans le store et de nom de dossier d'assets.",
      "label": "Nom affiche a l'utilisateur.",
      "defaultGender": "Genre selectionne par defaut au demarrage ('male' ou 'female').",
      "assetsBasePath": "Racine publique des assets de cette espece. Sert a construire les chemins relatifs (optionnel : on peut aussi mettre des chemins complets).",
      "genders": "Objet { male, female }. Chaque genre porte au minimum son propre 'model' (GLB de base) — male et femelle peuvent diverger de mesh.",
      "morphTargets": "Liste des sliders de morph disponibles (Phase 2). Chaque 'target' DOIT correspondre exactement a une cle de mesh.morphTargetDictionary du GLB.",
      "materials": "Liste des proprietes de materiau colorables (Phase 1). 'target' = nom du materiau dans le GLB, 'property' = propriete a teinter (ex: color).",
      "assetSlots": "Emplacements d'assets interchangeables (Phase 3) : coiffures, sourcils, barbes. Chaque slot liste ses options (GLB) et le point de montage sur le squelette."
    }
  },
